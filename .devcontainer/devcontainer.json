{
  "name": "SDM Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "overrideCommand": false,
  "remoteUser": "root",
  "containerEnv": {
    "POSTGRES_PASSWORD": "sdm-local-development-only"
  },
  "forwardPorts": [5432],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools-extension-pack",
        "ms-ossdata.vscode-pgsql"
      ]
    }
  }
}
